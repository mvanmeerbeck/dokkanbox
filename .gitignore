spike-ios/refpack*.bin

# engendré par xcodegen depuis project.yml
spike-ios/DokkanScanSpike.xcodeproj/

# captures et enregistrements de travail
*.MP4
*.mov
Capture d’écran*.png
*.ips

.DS_Store

# page construite mise de côté, 14,5 Mo
tools/keep/grille-planches.html
tools/__pycache__/
